# Copy this file to ".env" and fill in your real keys.
# .env should NEVER be committed to git -- add it to .gitignore.

# Required -- used by enrich.py for all Gemini calls
GEMINI_API_KEY=your_gemini_key_here

# Optional -- used by search_fetch.py for manufacturer page lookup.
# Leave blank if you don't have one yet: the pipeline still runs,
# it just skips MFR URL / spec-sheet-derived fields (see enrich.py
# module docstring for details on this fallback behavior).
# Get a free key at https://serper.dev -- search_fetch.py is already
# wired to call Serper's API directly once this is set.
SEARCH_API_KEY=

ACCESS_CODE=

